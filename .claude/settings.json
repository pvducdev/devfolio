{
  "permissions": {
    "allow": [
      "Bash(find:*)",
      "Bash(tree:*)",
      "Bash(pnpm outdated)",
      "Bash(npm outdated:*)",
      "WebSearch",
      "WebFetch(domain:motion.dev)",
      "Bash(xargs:*)",
      "Skill(example-skills:frontend-design)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "WebFetch(domain:www.tailwind-variants.org)"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "pnpm fix",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      }
    ]
  }
}
