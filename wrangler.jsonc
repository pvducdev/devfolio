{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devfolio",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",

  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 },
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1000",
      "simple": { "limit": 100, "period": 60 },
    },
  ],
  "secrets": {
    "required": [
      "LLM_API_KEY",
      "LOGTAIL_SOURCE_TOKEN",
      "LOGTAIL_INGESTING_HOST",
      "GIT_CONTRIBUTION_TOKEN",
    ],
  },

  "env": {
    "staging": {
      "workers_dev": true,
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 100, "period": 60 },
        },
      ],
      "secrets": {
        "required": [
          "LLM_API_KEY",
          "LOGTAIL_SOURCE_TOKEN",
          "LOGTAIL_INGESTING_HOST",
          "GIT_CONTRIBUTION_TOKEN",
        ],
      },
    },
    "production": {
      "workers_dev": false,
      "routes": [
        { "pattern": "pvduc.id.vn/*", "zone_name": "pvduc.id.vn" },
        { "pattern": "www.pvduc.id.vn/*", "zone_name": "pvduc.id.vn" },
      ],
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 100, "period": 60 },
        },
      ],
      "secrets": {
        "required": [
          "LLM_API_KEY",
          "LOGTAIL_SOURCE_TOKEN",
          "LOGTAIL_INGESTING_HOST",
          "GIT_CONTRIBUTION_TOKEN",
        ],
      },
    },
  },
}
